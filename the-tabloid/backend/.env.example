# BytePlus — Seed 2.0 (LLM brain), Seedance 2.0 (T2V video), Seedream (image).
BYTEPLUS_API_KEY=
BYTEPLUS_BASE_URL=https://api.byteplus.com/seedance/v1
SEED_LLM_BASE_URL=https://api.byteplus.com/seed/v1
SEED_LLM_MODEL=seed-2.0
SEEDREAM_BASE_URL=https://api.byteplus.com/seedream/v1
SEEDREAM_MODEL=seedream-3.0

# BytePlus — Seed Speech (TTS). Confirm endpoint from BytePlus console.
SEED_SPEECH_API_KEY=
SEED_SPEECH_BASE_URL=https://api.byteplus.com/speech/v1

# OpenRouter — used for the research agent (Gemini with Google grounding).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_RESEARCH_MODEL=google/gemini-2.5-flash

# Firebase
FIREBASE_PROJECT_ID=
# Leave FIREBASE_STORAGE_BUCKET empty to run without Firebase Storage — the
# backend will serve finished videos from disk via /api/videos/{id}.mp4 instead.
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Public URL for the backend when served to the browser (used to build
# video_url when Firebase Storage isn't configured). Set to your domain in prod.
PUBLIC_BASE_URL=http://localhost:8000

# Persistent data directory for finished episodes. Survives restarts.
# Default ./data resolves against the cwd that runs uvicorn (so usually
# the-tabloid/data/audio and the-tabloid/data/videos).
TABLOID_DATA_DIR=./data

# Celery / Redis
REDIS_URL=redis://localhost:6379/0

# Optional fallback if RSS fails
NEWS_API_KEY=

# Provider toggles — default to BytePlus Seed everywhere.
# Flip individually when a given Seed surface is blocked.
#   LLM_PROVIDER:   byteplus | openrouter
#   TTS_PROVIDER:   byteplus | elevenlabs | google
#   VIDEO_PROVIDER: byteplus | fal | mock
#   IMAGE_PROVIDER: byteplus | fal | mock
LLM_PROVIDER=byteplus
TTS_PROVIDER=byteplus
VIDEO_PROVIDER=byteplus
IMAGE_PROVIDER=byteplus

# Fallback provider credentials — only needed if you flip away from byteplus.
ELEVENLABS_API_KEY=
# eleven_multilingual_v2 is far more expressive (and accent-aware) than turbo.
ELEVENLABS_MODEL=eleven_multilingual_v2

# Fal video model — flip between img2video and text-to-video by changing
# this single value. Both have native audio + lip sync on Seedance 2.0.
#   bytedance/seedance-2.0/fast/image-to-video   ← portrait → video, ~$0.24/sec
#                                                  Pro: locked face. Con: Fal's
#                                                  partner moderator rejects
#                                                  photoreal portraits.
#   bytedance/seedance-2.0/fast/text-to-video    ← prompt only, ~$0.24/sec
#                                                  Pro: no image policy fight,
#                                                  more dynamic compositions.
#                                                  Con: ~80% character
#                                                  consistency vs ~95% on i2v.
# Pipeline auto-detects "text-to-video" in this string and skips portrait gen.
# FAL_VIDEO_MODEL=bytedance/seedance-2.0/fast/image-to-video

# Google AI Studio (for TTS_PROVIDER=google). Grab a key at:
# https://aistudio.google.com/apikey  (free tier covers hackathon volumes)
GOOGLE_AISTUDIO_API_KEY=
GOOGLE_TTS_MODEL=gemini-2.5-flash-preview-tts
FAL_KEY=

# Dev toggles — set TABLOID_MOCK=1 to stub all external APIs (useful for local dev)
TABLOID_MOCK=0
